{
  "sdk": "CC2X",
  "tested_version": "0.8.1-client-beta.1",
  "api_version": 8,
  "default_directory": "../cc2x",
  "override_argument": "--sdk",
  "override_environment": "CC2X_SDK_DIR",
  "validation": "Separate-addon offline validation; owner host acceptance for the earlier local prototype. New delivery requires its own manual check. Remote and dedicated unverified.",
  "required_extensions": [
    {
      "name": "cc2x.session",
      "version": 1,
      "query_export": "cc2x_query_session_v1"
    }
  ],
  "lua_api_version": 2,
  "runtime_capabilities": [
    "lua-mod-api-v2",
    "waypoint-origin-v1",
    "screen-extensions-v1",
    "screen-source-edits-v1"
  ]
}
